{
  "name": "k2gl/in-toto-attestation",
  "description": "Faithful, typed PHP implementation of the in-toto Attestation Framework (Statement v1): build, sign and verify attestations over k2gl/dsse.",
  "homepage": "https://github.com/k2gl/in-toto-attestation",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "in-toto",
    "attestation",
    "statement",
    "provenance",
    "slsa",
    "sigstore",
    "supply-chain",
    "dsse",
    "signing"
  ],
  "authors": [
    {
      "name": "Nickolay Harin",
      "email": "l0gic@ya.ru"
    }
  ],
  "support": {
    "issues": "https://github.com/k2gl/in-toto-attestation/issues",
    "source": "https://github.com/k2gl/in-toto-attestation"
  },
  "require": {
    "php": ">=8.1",
    "k2gl/dsse": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10|^11|^12",
    "phpstan/phpstan": "^2.1",
    "laravel/pint": "^1.29",
    "k2gl/phpunit-fluent-assertions": "^12"
  },
  "suggest": {
    "ext-sodium": "Required by the Ed25519 signer/verifier from k2gl/dsse used in the examples and tests."
  },
  "autoload": {
    "psr-4": {
      "K2gl\\InToto\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "K2gl\\InToto\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse",
    "cs": "pint --test",
    "cs-fix": "pint",
    "check": [
      "@test",
      "@phpstan",
      "@cs"
    ]
  }
}
